# Koneksi MySQL (cPanel: user & database biasanya berawalan nama akun, mis. akun_kesiswaan)
DATABASE_URL="mysql://kesiswaan:kesiswaan@localhost:3306/kesiswaan"

# Auth.js — buat dengan: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-string-acak-panjang"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# WA Gateway (adapter generik; dipakai mulai Tahap 3)
WA_GATEWAY_URL=""
WA_GATEWAY_TOKEN=""

# Token untuk endpoint cron (/api/cron/*)
CRON_SECRET="ganti-dengan-token-acak"

# Zona waktu aplikasi
APP_TIMEZONE="Asia/Makassar"

# Folder penyimpanan unggahan (di luar public). Relatif terhadap root aplikasi atau path absolut.
UPLOAD_DIR="./uploads"
